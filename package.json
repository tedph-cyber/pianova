{
  "name": "pianova",
  "version": "0.2.0",
  "description": "A vanilla TypeScript piano keyboard component with built-in Web Audio synthesis, pointer input, Web MIDI and a music-theory module",
  "type": "module",
  "main": "dist/pianova.cjs",
  "module": "dist/pianova.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pianova.mjs",
      "require": "./dist/pianova.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./theory": {
      "types": "./dist/types/theory/index.d.ts",
      "import": "./dist/theory.mjs",
      "require": "./dist/theory.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "pianova.png"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "start": "npm run build && npx serve . -l 3000 --no-clipboard",
    "serve": "npx serve .",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "piano",
    "keyboard",
    "music",
    "web-audio",
    "typescript",
    "vanilla",
    "no-dependencies",
    "midi",
    "web-midi",
    "music-theory",
    "solfege",
    "chords",
    "scales"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@vitest/ui": "^4.1.9",
    "jsdom": "^29.1.1",
    "rollup": "^4.28.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.28.0",
    "@rollup/rollup-linux-x64-musl": "^4.28.0",
    "@rollup/rollup-darwin-x64": "^4.28.0"
  },
  "typesVersions": {
    "*": {
      "theory": [
        "dist/types/theory/index.d.ts"
      ]
    }
  }
}
